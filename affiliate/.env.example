# =========================================================================
#  MasterStox · AliExpress Affiliate Automation — משתני סביבה
#  העתק קובץ זה ל-.env ומלא את הערכים. אל תעלה את .env ל-git!
#  (ב-GitHub Actions מגדירים את אלה כ-Secrets בהגדרות המאגר)
# =========================================================================

# ---- AliExpress Affiliate (Open Platform) ----
# נרשמים ב-https://portals.aliexpress.com ו-https://openservice.aliexpress.com
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# מזהה ה-Tracking / PID שלך מפורטל האפילייט
ALIEXPRESS_TRACKING_ID=masterstox

# ---- Instagram Graph API (Meta) ----
# חשבון Instagram מסוג Business/Creator המחובר לעמוד פייסבוק + אפליקציית Meta
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- כתובת אתר ה-link-in-bio (GitHub Pages) ----
# נכנס לכיתוב הפוסטים כ"קישור בביו"
SITE_BASE_URL=https://oratai99.github.io/-sql/affiliate/site/

# ---- העדפות כלליות ----
TARGET_CURRENCY=ILS
TARGET_LANGUAGE=HE
SHIP_TO_COUNTRY=IL
